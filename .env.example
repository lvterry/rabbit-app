# Database
DATABASE_URL=postgresql://rabbit:rabbit_local_password@localhost:5432/rabbit_dev
POSTGRES_USER=rabbit
POSTGRES_PASSWORD=rabbit_local_password
POSTGRES_DB=rabbit_dev

# API
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# Web
VITE_API_BASE_URL=http://localhost:3000
VITE_USE_FIXTURES=0

# Auth (Sign in with Apple)
# These should be set in production/staging
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_SERVICE_ID=

# APNs
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_PRODUCTION=false

# Email (for magic link)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Session
SESSION_SECRET=local_dev_secret_change_in_production
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=15552000

# Domain
WEB_DOMAIN=localhost:5173
