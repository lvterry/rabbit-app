# E2E Test Environment Variables
# Copy this to .env.test and fill in values after Maya's seed PR merges

# API base URL (should match VITE_API_BASE in .env)
API_BASE=http://localhost:8787

# Seed-created invite token (Maya's seed will provide this)
# Tests will skip if not set
INVITE_TOKEN=

# Optional: Specific IDs created by seed
# STUDENT_ID=
# TEACHER_ID=
# COURSE_ID=
# PACKAGE_ID=

# Optional: Bookable slot for assertions
# BOOKABLE_SLOT_START=2026-09-25T10:00:00Z
# BOOKABLE_SLOT_END=2026-09-25T11:00:00Z

# Optional: Expected credit count before booking
# REMAINING_BEFORE=8
