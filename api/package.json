{
  "name": "@rabbit/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:domain": "vitest run test/domain",
    "test:db": "vitest run test/db",
    "test:integration": "vitest run test/integration",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@rabbit/shared": "workspace:*",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "cookie-parser": "^1.4.6",
    "jsonwebtoken": "^9.0.2",
    "crypto": "npm:node-stdlib-browser@^1.2.0",
    "node-apn": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/cookie-parser": "^1.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0",
    "tsx": "^4.7.0"
  }
}
